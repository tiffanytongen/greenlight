# Copy to .env, set the URL, restart `npx expo start`.
# This is the ONLY config the app needs — provider keys live on the server
# (see ../server/.env.example), never in the app bundle.

# Local dev: your Mac's LAN IP + the proxy port, e.g. http://192.168.1.23:8787
# Deployed:  your host URL, e.g. https://greenlight-proxy.onrender.com
EXPO_PUBLIC_GREENLIGHT_API=

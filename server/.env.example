# Copy to server/.env — NEVER commit the real .env.

# Anthropic: interprets worker text and reads crop photos (console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs: speech-to-text + text-to-speech (elevenlabs.io -> API keys)
ELEVENLABS_API_KEY=

# Optional overrides (defaults are the current ElevenLabs models;
# scribe_v1 and eleven_turbo_v2_5 were deprecated/removed in 2026)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# PORT=8787

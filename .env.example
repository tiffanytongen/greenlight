# Copy to .env and edit. Everything runs offline with these left as-is.

# Reasoner: mock (offline heuristic, default) | anthropic | openai
GREENLIGHT_LLM=mock

# Weather: snapshot (offline, default) | live (Open-Meteo, no key needed)
GREENLIGHT_WEATHER=snapshot

# Only needed when GREENLIGHT_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Only needed when GREENLIGHT_LLM=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
